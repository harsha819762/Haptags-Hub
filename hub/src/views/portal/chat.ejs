<%
  const online = new Set(data.online);
  const isActive = function (c) { return current && current.id === c.id; };
  const memberIds = members.map(function (m) { return m.id; });
  const groups = conversations.filter(function (c) { return c.kind === 'group'; });
  const directs = conversations.filter(function (c) { return c.kind === 'dm'; });
%>
<div class="chat<%= current ? ' has-channel' : '' %>">
  <aside class="chat-list" aria-label="Conversations">
    <div class="chat-list-head">
      <h1>Chat</h1>
      <% if (isTeam) { %><button class="btn btn-sm" type="button" data-dialog="#new-group"><%- h.icon('plus', 15) %> New group</button><% } %>
    </div>
    <div class="chat-quick">
      <form method="post" action="<%= base %>/meetings/now" target="_blank" data-no-disable><%- include('../partials/csrf') %><button class="chat-quick-btn" type="submit"><span class="ic green"><%- h.icon('video', 17) %></span>Meet now</button></form>
      <a class="chat-quick-btn" href="<%= base %>/meetings/new"><span class="ic blue"><%- h.icon('calendar', 17) %></span>Schedule</a>
      <a class="chat-quick-btn" href="<%= base %>/meetings"><span class="ic violet"><%- h.icon('clock', 17) %></span>Meetings</a>
    </div>
    <% if (!isTeam) { %>
    <div class="chat-group">
      <div class="chat-group-head"><span>Your team chat</span></div>
      <% conversations.forEach(function (c) { %>
      <a class="chat-item<%= isActive(c) ? ' active' : '' %>" href="<%= base %>/<%= c.id %>" data-channel-link="<%= c.id %>"<%- isActive(c) ? ' aria-current="page"' : '' %>>
        <span class="avatar avatar-sm avatar-group"><%- h.icon('team', 14) %></span>
        <span class="chat-name"><%= c.label %><small>Group chat with Haptags</small></span>
        <span class="count" data-unread<%= c.unread ? '' : ' hidden' %>><%= c.unread %></span>
      </a>
      <% }) %>
    </div>
    <div class="chat-group">
      <div class="chat-group-head"><span>Your Haptags contacts</span></div>
      <% if (!people.length) { %><p class="chat-hint">Your Haptags contacts will appear here.</p><% } %>
      <% people.forEach(function (u) { %>
      <div class="chat-item chat-person" style="cursor:default">
        <span class="avatar avatar-sm<%= online.has(u.id) ? ' online' : '' %>" data-presence="<%= u.id %>"><%= h.initials(u.name) %></span>
        <span class="chat-name"><%= u.name %><small><%= h.humanize(u.role) === 'Owner' ? 'Haptags' : 'Haptags team' %></small></span>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="chat-group">
      <div class="chat-group-head"><span>Groups</span><button class="icon-btn" type="button" data-dialog="#new-group" title="New group" aria-label="New group"><%- h.icon('plus', 15) %></button></div>
      <% if (!groups.length) { %><p class="chat-hint">Make a group to chat with several people at once.</p><% } %>
      <% groups.forEach(function (c) { %>
      <a class="chat-item<%= isActive(c) ? ' active' : '' %>" href="<%= base %>/<%= c.id %>" data-channel-link="<%= c.id %>"<%- isActive(c) ? ' aria-current="page"' : '' %>>
        <span class="avatar avatar-sm avatar-group"><%- h.icon('team', 14) %></span>
        <span class="chat-name"><%= c.label %><small><%= (c.people || []).length + 1 %> members</small></span>
        <span class="count" data-unread<%= c.unread ? '' : ' hidden' %>><%= c.unread %></span>
      </a>
      <% }) %>
    </div>
    <div class="chat-group">
      <div class="chat-group-head"><span>Direct messages</span></div>
      <% if (!directs.length) { %><p class="chat-hint">Tap a team member below to message them privately.</p><% } %>
      <% directs.forEach(function (c) { %>
      <a class="chat-item<%= isActive(c) ? ' active' : '' %>" href="<%= base %>/<%= c.id %>" data-channel-link="<%= c.id %>"<%- isActive(c) ? ' aria-current="page"' : '' %>>
        <span class="avatar avatar-sm<%= online.has(c.otherId) ? ' online' : '' %>" data-presence="<%= c.otherId %>"><%= h.initials(c.label) %></span>
        <span class="chat-name"><%= c.label %></span>
        <span class="count" data-unread<%= c.unread ? '' : ' hidden' %>><%= c.unread %></span>
      </a>
      <% }) %>
    </div>
    <div class="chat-group">
      <div class="chat-group-head"><span><%= isTeam ? 'People' : 'Your Haptags contacts' %> <small class="muted" style="text-transform:none;letter-spacing:0">· tap to message</small></span></div>
      <% people.filter(function (u) { return u.role !== 'client'; }).forEach(function (u) { %>
      <form method="post" action="<%= base %>/new" data-no-disable>
        <%- include('../partials/csrf') %><input type="hidden" name="user_ids" value="<%= u.id %>">
        <button class="chat-item chat-person" type="submit" title="Message <%= u.name %>">
          <span class="avatar avatar-sm<%= online.has(u.id) ? ' online' : '' %>" data-presence="<%= u.id %>"><%= h.initials(u.name) %></span>
          <span class="chat-name"><%= u.name %><small><%= u.company || h.humanize(u.role) %></small></span>
        </button>
      </form>
      <% }) %>
    </div>
    <% } %>
  </aside>

  <section class="chat-main">
    <% if (!current) { %>
    <div class="empty chat-empty"><%- h.icon('chat', 34) %><b><%= isTeam ? 'Your conversations' : 'Talk to the Haptags team' %></b>Pick a conversation, or tap someone to say hello. You can also start a call or schedule a meeting.</div>
    <% } else { %>
    <header class="chat-head">
      <a class="icon-btn chat-back" href="<%= base %>?list=1" aria-label="All conversations"><%- h.icon('back', 20) %></a>
      <div class="chat-title">
        <h2><%= current.label %></h2>
        <div class="sub">
          <% if (current.kind === 'dm') { %>Direct message · <span data-presence-text="<%= current.otherId %>"><%= online.has(current.otherId) ? 'Online' : 'Offline' %></span><% } else { %>Group · <%= members.length %> members: <%= members.map(function (m) { return m.id === user.id ? 'You' : m.name.split(' ')[0]; }).join(', ') %><% } %>
        </div>
      </div>
      <div class="chat-actions">
        <form method="post" action="<%= base %>/<%= current.id %>/call" class="inline" target="_blank" data-no-disable>
          <%- include('../partials/csrf') %><input type="hidden" name="voice" value="1">
          <button class="btn btn-ghost btn-sm" type="submit" title="Start a voice call"><%- h.icon('phone', 16) %><span class="hide-sm"> Voice</span></button>
        </form>
        <form method="post" action="<%= base %>/<%= current.id %>/call" class="inline" target="_blank" data-no-disable>
          <%- include('../partials/csrf') %>
          <button class="btn btn-sm" type="submit" title="Start a video call"><%- h.icon('video', 16) %><span class="hide-sm"> Video</span></button>
        </form>
        <% if (current.kind === 'group' && isTeam) { %><button class="btn btn-ghost btn-sm" type="button" data-dialog="#group-info" title="Group details"><%- h.icon('info', 16) %><span class="hide-sm"> Members</span></button><% } %>
        <a class="btn btn-ghost btn-sm" href="<%= base %>/meetings/new?<%= memberIds.filter(function (id) { return id !== user.id; }).map(function (id) { return 'user_ids=' + id; }).join('&') %>" title="Schedule a meeting"><%- h.icon('calendar', 16) %><span class="hide-sm"> Schedule</span></a>
      </div>
    </header>
    <div class="chat-scroll" data-scroll>
      <div class="chat-more"><button class="btn btn-ghost btn-sm" type="button" data-more hidden>Load earlier messages</button></div>
      <div class="chat-messages" data-messages></div>
      <noscript><div class="empty">Chat needs JavaScript turned on.</div></noscript>
    </div>
    <div class="chat-typing" data-typing aria-live="polite"></div>
    <form class="composer" data-composer>
      <label class="icon-btn composer-btn" title="Attach a file (up to 8 MB)">
        <%- h.icon('paperclip', 19) %><span class="sr-only">Attach a file</span>
        <input type="file" data-file hidden>
      </label>
      <textarea rows="1" data-input aria-label="Message" placeholder="Message <%= current.label %>"></textarea>
      <button class="btn composer-send" type="submit" aria-label="Send"><%- h.icon('send', 17) %></button>
    </form>
    <% } %>
  </section>
</div>

<% if (isTeam) { %>
<dialog class="modal" id="new-group" aria-labelledby="new-group-title">
  <form method="post" action="<%= base %>/groups">
    <%- include('../partials/csrf') %>
    <div class="modal-head"><h2 id="new-group-title">New group</h2><button class="icon-btn" type="button" data-close aria-label="Close"><%- h.icon('x') %></button></div>
    <div class="modal-body">
      <div class="field"><label for="group-name">Group name</label><input id="group-name" name="name" type="text" maxlength="120" placeholder="e.g. Website launch" required></div>
      <div class="muted small mb-8">Add people from the team</div>
      <div class="pick-list">
        <% people.filter(function (u) { return u.role !== 'client'; }).forEach(function (u) { %>
        <label class="check pick"><input type="checkbox" name="user_ids" value="<%= u.id %>"><span class="avatar avatar-sm<%= online.has(u.id) ? ' online' : '' %>" data-presence="<%= u.id %>"><%= h.initials(u.name) %></span><span><%= u.name %><span class="muted small"> · <%= u.company || h.humanize(u.role) %></span></span></label>
        <% }) %>
      </div>
    </div>
    <div class="modal-foot"><button class="btn btn-ghost" type="button" data-close>Cancel</button><button class="btn" type="submit">Create group</button></div>
  </form>
</dialog>

<% if (current && current.kind === 'group' && isTeam) { const others = people.filter(function (u) { return memberIds.indexOf(u.id) === -1; }); %>
<dialog class="modal" id="group-info" aria-labelledby="group-info-title">
  <div class="modal-head"><h2 id="group-info-title">Group details</h2><button class="icon-btn" type="button" data-close aria-label="Close"><%- h.icon('x') %></button></div>
  <div class="modal-body">
    <form method="post" action="<%= base %>/<%= current.id %>/rename" class="mb-16">
      <%- include('../partials/csrf') %>
      <div class="field"><label for="info-name">Group name</label><input id="info-name" name="name" type="text" maxlength="120" value="<%= current.label %>"></div>
      <button class="btn btn-ghost btn-sm" type="submit">Save name</button>
    </form>
    <h3><%= members.length %> members</h3>
    <ul class="list member-list">
      <% members.forEach(function (m) { %>
      <li><span class="avatar avatar-sm<%= online.has(m.id) ? ' online' : '' %>" data-presence="<%= m.id %>"><%= h.initials(m.name) %></span><span class="grow"><span class="title"><%= m.name %><%= m.id === user.id ? ' (you)' : '' %></span><span class="meta"><%= m.role === 'client' ? 'Client' : 'Haptags team' %></span></span></li>
      <% }) %>
    </ul>
    <% if (others.length) { %>
    <form method="post" action="<%= base %>/<%= current.id %>/members" class="mt-16">
      <%- include('../partials/csrf') %>
      <h3>Add people</h3>
      <div class="pick-list"><% others.forEach(function (u) { %><label class="check pick"><input type="checkbox" name="user_ids" value="<%= u.id %>"><span class="avatar avatar-sm"><%= h.initials(u.name) %></span><span><%= u.name %></span></label><% }) %></div>
      <button class="btn btn-sm mt-8" type="submit">Add to group</button>
    </form>
    <% } %>
  </div>
  <div class="modal-foot">
    <form method="post" action="<%= base %>/<%= current.id %>/leave" data-confirm="Leave this group?"><%- include('../partials/csrf') %><button class="btn btn-danger" type="submit">Leave group</button></form>
    <button class="btn btn-ghost" type="button" data-close>Close</button>
  </div>
</dialog>
<% } %>
<% } %>
<script type="application/json" id="chat-data"><%- h.json(data) %></script>
