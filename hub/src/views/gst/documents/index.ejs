<%- include('../_nav', { active: type }) %>
<%
  const newKind = type === 'notes' ? null : type;
  const keep = { type: type, q: q, client: clientId, from: from, to: to };
%>
<div class="page-head">
  <div>
    <h1><%= typeTitle %></h1>
    <div class="sub"><%= type === 'invoice' ? 'Rule 46 tax invoices, numbered per financial year. Finalised invoices are locked.' : type === 'proforma' ? 'Quotations and proformas. Not tax invoices; convert one when the client confirms.' : 'Corrections to finalised tax invoices (Rule 53). Create one from the invoice it adjusts.' %></div>
  </div>
  <div class="actions">
    <% if (newKind) { %><a class="btn" href="/invoices/docs/new?kind=<%= newKind %>"><%- h.icon('plus', 16) %> New <%= newKind === 'invoice' ? 'tax invoice' : 'proforma' %></a><% } else { %>
      <a class="btn btn-ghost" href="/invoices/docs/new?kind=debit_note"><%- h.icon('plus', 16) %> Debit note</a>
      <a class="btn" href="/invoices/docs/new?kind=credit_note"><%- h.icon('plus', 16) %> Credit note</a>
    <% } %>
  </div>
</div>

<nav class="tabs">
  <% tabs.forEach(function (t) { %><a href="<%= h.qs('/invoices/docs', Object.assign({}, keep, { status: t[0] })) %>" class="<%= status === t[0] ? 'active' : '' %>"><%= t[1] %></a><% }) %>
</nav>
<form method="get" class="gst-list-filters mb-16">
  <input type="hidden" name="type" value="<%= type %>"><input type="hidden" name="status" value="<%= status %>">
  <input type="search" name="q" value="<%= q || '' %>" placeholder="Number, client, GSTIN, subject…" aria-label="Search">
  <select name="client" aria-label="Client" data-autosubmit><option value="">All clients</option><% clients.forEach(function (c) { %><option value="<%= c.id %>" <%= h.selected(clientId, c.id) %>><%= c.name %></option><% }) %></select>
  <input type="date" name="from" value="<%= from || '' %>" aria-label="From date">
  <input type="date" name="to" value="<%= to || '' %>" aria-label="To date">
  <button class="btn btn-ghost btn-sm" type="submit">Filter</button>
  <% if (q || clientId || from || to) { %><a class="btn-link small" href="<%= h.qs('/invoices/docs', { type: type, status: status }) %>">Clear</a><% } %>
</form>

<div class="card">
  <% if (!rows.length) { %>
    <div class="empty"><b>Nothing here yet</b><%= type === 'notes' ? 'Open a finalised tax invoice and choose “Credit note” or “Debit note”.' : 'Create one with the button above.' %></div>
  <% } else { %>
  <div class="table-wrap"><table class="table gst-table">
    <thead><tr>
      <th>Number</th><th>Date</th><th>Client</th><th class="hide-sm">Supply</th><th class="num">Total</th>
      <% if (type === 'invoice') { %><th class="num">Balance</th><% } %><th>Status</th>
    </tr></thead>
    <tbody>
      <% rows.forEach(function (d) { const st = g.displayStatus(d, today); %>
      <tr class="<%= st === 'cancelled' ? 'is-cancelled' : '' %>">
        <td><a class="strong mono" href="/invoices/docs/<%= d.id %>"><%= g.docLabel(d) %></a><span class="sub"><%= type === 'notes' ? g.kindLabel(d.kind) : (d.subject || '') %></span></td>
        <td class="nowrap"><%= h.date(d.issue_date) %><% if (d.kind === 'invoice' && d.due_date && d.number) { %><span class="sub <%= st === 'overdue' ? 'down' : '' %>">Due <%= h.date(d.due_date) %></span><% } %></td>
        <td><% if (d.hub_client_id) { %><a href="/invoices/clients/<%= d.hub_client_id %>"><%= d.bill_name %></a><% } else { %><%= d.bill_name %><% } %><span class="sub mono"><%= d.bill_gstin || (d.client_type === 'export' ? d.bill_country : 'Unregistered') %></span></td>
        <td class="hide-sm small"><%= d.supply_type === 'intra' ? 'CGST+SGST' : d.supply_type === 'inter' ? 'IGST' : 'Export' %><span class="sub"><%= d.pos_name %> (<%= d.pos_code %>)</span></td>
        <td class="num"><%= g.money(d.total, d.currency) %><% if (d.currency !== 'INR') { %><span class="sub"><%= h.inr(d.inr_total) %></span><% } %></td>
        <% if (type === 'invoice') { %><td class="num <%= d.number && Number(d.balance) > 0 && st !== 'cancelled' ? 'strong' : 'muted' %>"><%= d.number && st !== 'cancelled' ? g.money(Math.max(0, d.balance), d.currency) : '—' %></td><% } %>
        <td><%- g.badge(st) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <%- include('../../partials/pager', { pagerBase: '/invoices/docs', pagerQuery: Object.assign({}, keep, { status: status }) }) %>
  <% } %>
</div>
