<%- include('../_nav', { active: 'clients' }) %>
<div class="page-head">
  <div><h1>Clients</h1><div class="sub">Your Hub clients, with the details GST needs. Adding or editing one here updates the Hub’s Clients too.</div></div>
  <div class="actions"><a class="btn" href="/team/gst/clients/new"><%- h.icon('plus', 16) %> New client</a></div>
</div>
<% if (needsFixing) { %>
<div class="flash flash-info"><%- h.icon('info') %><span><b><%= needsFixing %> client<%= needsFixing === 1 ? '' : 's' %></b> need<%= needsFixing === 1 ? 's' : '' %> a state or a valid GSTIN before a tax invoice can be finalised. They’re marked below.</span></div>
<% } %>
<div class="row-between">
  <nav class="tabs">
    <% [['', 'All']].concat(g.C.CLIENT_TYPES).forEach(function (t) { %><a href="<%= h.qs('/team/gst/clients', { type: t[0], q: q, inactive: showInactive ? '1' : '' }) %>" class="<%= type === t[0] ? 'active' : '' %>"><%= t[0] ? t[0].toUpperCase() : t[1] %></a><% }) %>
  </nav>
  <form method="get" class="gst-list-filters mb-16">
    <input type="hidden" name="type" value="<%= type %>">
    <input type="search" name="q" value="<%= q || '' %>" placeholder="Name, GSTIN, city, email, phone…" aria-label="Search clients">
    <label class="check small"><input type="checkbox" name="inactive" value="1" <%= showInactive ? 'checked' : '' %> data-autosubmit> Show inactive</label>
  </form>
</div>
<div class="card">
  <% if (!rows.length) { %><div class="empty"><b>No clients<%= q ? ' match “' + q + '”' : ' yet' %></b><a href="/team/gst/clients/new">Add a client</a></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Client</th><th>Type</th><th>GSTIN</th><th>State / country</th><th class="hide-sm">Contact</th></tr></thead>
    <tbody>
      <% rows.forEach(function (c) { %>
      <tr class="<%= c.is_active ? '' : 'is-cancelled' %>">
        <td><a class="strong" href="/team/gst/clients/<%= c.id %>"><%= c.name %></a>
          <% if (c.issues.length) { %><span class="sub down">Needs fixing: <%= c.issues.join(', ') %> · <a href="/team/gst/clients/<%= c.id %>/edit">Fix</a></span><% } else if (!c.is_active) { %><span class="sub">Inactive</span><% } %></td>
        <td><span class="badge tone-<%= c.client_type === 'b2b' ? 'blue' : c.client_type === 'export' ? 'violet' : 'grey' %>"><%= c.client_type.toUpperCase() %></span></td>
        <td class="mono small"><%= c.gstin || '—' %></td>
        <td><%= c.client_type === 'export' ? c.country : (c.state_name || '—') %><% if (c.state_code && c.client_type !== 'export') { %><span class="sub"><%= c.state_code %></span><% } %></td>
        <td class="hide-sm small"><%= c.contact_person || '' %><span class="sub"><%= [c.email, c.phone].filter(Boolean).join(' · ') %></span></td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <%- include('../../partials/pager', { pagerBase: '/team/gst/clients', pagerQuery: { type: type, q: q, inactive: showInactive ? '1' : '' } }) %>
  <% } %>
</div>
