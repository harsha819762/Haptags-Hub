<%- include('_nav', { active: 'audit' }) %>
<div class="page-head">
  <div><h1>Audit log</h1><div class="sub">Every change in GST Invoices: who did it, when, and from where. Entries can’t be edited or removed.</div></div>
</div>
<nav class="tabs">
  <% [['', 'Everything'], ['document', 'Documents'], ['payment', 'Payments'], ['client', 'Clients'], ['item', 'Services'], ['profile', 'Business profile'], ['report', 'Exports'], ['backup', 'Backups']].forEach(function (t) { %>
    <a href="<%= h.qs('/invoices/audit', { entity: t[0] }) %>" class="<%= entity === t[0] ? 'active' : '' %>"><%= t[1] %></a>
  <% }) %>
</nav>
<div class="card">
  <% if (!rows.length) { %><div class="empty">Nothing logged yet.</div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>When</th><th>Who</th><th>What</th><th>Details</th></tr></thead>
    <tbody>
      <% rows.forEach(function (a) { const d = a.entity_type === 'document' ? docs[a.entity_id] : null; %>
      <tr>
        <td class="nowrap small"><%= h.dateTime(a.created_at) %></td>
        <td class="small"><%= a.user_name || 'System' %><span class="sub mono"><%= a.ip || '' %></span></td>
        <td class="small"><b><%= h.humanize(a.entity_type) %></b> · <%= h.humanize(a.action) %><% if (d) { %><span class="sub"><a class="mono" href="/invoices/docs/<%= d.id %>"><%= g.docLabel(d) %></a></span><% } else if (a.entity_type === 'client' && a.entity_id) { %><span class="sub"><a href="/invoices/clients/<%= a.entity_id %>">Open client</a></span><% } %></td>
        <td class="small"><%= a.summary %>
          <% if (a.changes) { const ch = JSON.parse(a.changes); %><details class="mt-8"><summary class="muted">Changes</summary><% Object.keys(ch).forEach(function (f) { %><div><b><%= h.humanize(f) %></b>: <%= ch[f][0] || '—' %> → <%= ch[f][1] || '—' %></div><% }) %></details><% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <%- include('../partials/pager', { pagerBase: '/invoices/audit', pagerQuery: { entity: entity } }) %>
  <% } %>
</div>
