<!doctype html>
<html lang="en-IN" data-chat-base="<%= locals.chatBase || '/portal/chat' %>">
<head><script src="/static/js/theme-init.js"></script><%- include('../partials/head') %></head>
<body>
<div class="shell">
  <aside class="sidebar" aria-label="Navigation">
    <a class="brand" href="<%= locals.isTeam ? '/team' : '/portal' %>"><img src="/static/img/haptags-mark-light.webp" alt=""><span><b>HAPTAGS</b><small><%= locals.brandSub || 'Client Portal' %></small></span></a>
    <%
      const items = locals.navItems || [
        ['/portal', 'home', 'Overview', true],
        ['/portal/billing', 'payments', 'Billing'],
        ['/portal/chat', 'chat', 'Chat & Calls'],
        ['/portal/tickets', 'tickets', 'Support'],
        ['/portal/account', 'user', 'My account'],
      ];
      const full = locals.fullPath || '';
    %>
    <nav class="nav">
      <% items.forEach(function (it) { const active = it[3] ? full === it[0] : full === it[0] || full.startsWith(it[0] + '/'); %>
        <a href="<%= it[0] %>" class="<%= active ? 'active' : '' %>"<%- active ? ' aria-current="page"' : '' %>><%- h.icon(it[1]) %><span><%= it[2] %></span><% const badge = it[4] !== undefined ? it[4] : (it[0] === '/portal/chat' ? locals.chatUnread : 0); if (badge) { %><span class="count"><%= badge %></span><% } %></a>
      <% }) %>
    </nav>
    <div class="theme-switch" role="group" aria-label="Theme">
      <div class="side-label">Theme</div>
      <div class="side-seg">
        <button type="button" data-theme-set="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
        <button type="button" data-theme-set="system" aria-pressed="false">Auto</button>
      </div>
    </div>
    <div class="sidebar-foot">
      <% if (user.avatar_file_id) { %><img class="avatar avatar-img" src="/portal/avatar/<%= user.id %>?v=<%= user.avatar_file_id %>" alt=""><% } else { %><span class="avatar"><%= h.initials(user.name) %></span><% } %>
      <div class="who"><b><%= user.name %></b><% if (locals.isTeam) { %><span class="muted-foot">Haptags team</span><% } else { %><a href="/portal/account">My account</a><% } %></div>
      <form method="post" action="/logout" class="inline"><%- include('../partials/csrf') %><button class="icon-btn" title="Sign out" aria-label="Sign out"><%- h.icon('logout') %></button></form>
    </div>
  </aside>
  <div class="main">
    <header class="topbar">
      <button class="icon-btn menu-btn" data-nav-toggle aria-label="Open menu"><%- h.icon('menu', 22) %></button>
      <strong class="topbar-title"><%= locals.isTeam ? 'Haptags Team' : 'Haptags Portal' %></strong>
      <% if (!locals.isTeam) { %>
      <form class="topsearch" method="get" action="/portal/search" role="search">
        <%- h.icon('search', 16) %><input type="search" name="q" placeholder="Search…  Ctrl K" aria-label="Search" data-search autocomplete="off">
      </form>
      <% } %>
      <span class="spacer"></span>
      <% if (!locals.isTeam) { %>
      <a class="icon-btn top-icon search-link" href="/portal/search" aria-label="Search"><%- h.icon('search', 20) %></a>
      <a class="icon-btn top-icon bell" href="/portal/notifications" aria-label="Notifications"><%- h.icon('bell', 20) %><% if (locals.notifCount) { %><span class="bell-count"><%= notifCount > 9 ? '9+' : notifCount %></span><% } %></a>
      <% } %>
      <button class="icon-btn top-icon" type="button" data-theme-toggle aria-label="Switch light or dark mode" title="Light / dark"><svg class="ico theme-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg><svg class="ico theme-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      <% if (!locals.isTeam) { %>
      <% if (settings.whatsapp) { %><a class="btn btn-wa btn-sm" href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener"><%- h.icon('whatsapp', 16) %><span class="hide-sm"> WhatsApp</span></a><% } %>
      <a class="btn btn-sm" href="/portal/tickets/new"><%- h.icon('plus', 16) %><span class="hide-sm"> New request</span></a>
      <% } %>
    </header>
    <main class="content<%= locals.flush ? ' content-flush' : '' %>">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  </div>
</div>
<div class="toasts" data-toasts aria-live="polite"></div>
<script src="/static/js/app.js?v=<%= h.v('js/app.js') %>" defer></script>
<script src="/static/js/rt.js?v=<%= h.v('js/rt.js') %>" defer></script>
<script src="/static/js/portal.js?v=<%= h.v('js/portal.js') %>" defer></script>
<% (locals.scripts || []).forEach(function (s) { %><script src="/static/js/<%= s %>.js?v=<%= h.v('js/' + s + '.js') %>" defer></script>
<% }) %>
</body>
</html>
