<div class="crumbs no-print"><a href="/team/billing">Billing</a> / <%= doc.number %></div>
<div class="page-head no-print">
  <div><h1><%= DOC_LABEL[doc.type] %> <span class="mono" style="font-size:.7em"><%= doc.number %></span></h1><div class="sub">For <%= doc.client_name %> · <%= h.inr(doc.totals.total) %></div></div>
  <div class="actions">
    <button class="btn" type="button" data-print><%- h.icon('printer', 16) %> Print / Save as PDF</button>
    <% if (doc.type === 'quotation') { %><a class="btn btn-ghost" href="/team/billing/new?type=invoice&from=<%= doc.id %>">Turn into invoice</a><% } %>
    <% if (doc.type === 'invoice' && doc.status === 'open') { %><button class="btn btn-success" type="button" data-dialog="#paid-dialog"><%- h.icon('check', 16) %> Mark as paid</button><% } %>
    <% if (doc.type === 'quotation' && doc.status === 'open') { %><form method="post" action="/team/billing/<%= doc.id %>/accept" class="inline"><%- include('../partials/csrf') %><button class="btn btn-ghost" type="submit">Mark accepted</button></form><% } %>
    <form method="post" action="/team/billing/<%= doc.id %>/delete" class="inline" data-confirm="Delete this document?"><%- include('../partials/csrf') %><button class="btn btn-danger" type="submit"><%- h.icon('trash', 15) %></button></form>
  </div>
</div>
<% if (doc.type === 'invoice' && doc.status === 'open') { %>
<dialog class="modal" id="paid-dialog" aria-labelledby="paid-title">
  <form method="post" action="/team/billing/<%= doc.id %>/paid">
    <%- include('../partials/csrf') %>
    <div class="modal-head"><h2 id="paid-title">Mark as paid</h2><button class="icon-btn" type="button" data-close aria-label="Close"><%- h.icon('x') %></button></div>
    <div class="modal-body">
      <p class="muted small mt-0"><%= doc.client_name %> paid <%= h.inr(doc.totals.total) %>? We’ll close the invoice and make a receipt automatically.</p>
      <div class="field"><label for="pm">Paid by</label><select id="pm" name="pay_method"><option>UPI</option><option>Bank transfer</option><option>Cash</option><option>Card</option><option>Cheque</option></select></div>
      <div class="field mb-0"><label for="pr">Transaction / reference no. <span class="muted">(optional)</span></label><input id="pr" name="pay_ref" type="text"></div>
    </div>
    <div class="modal-foot"><button class="btn btn-ghost" type="button" data-close>Cancel</button><button class="btn btn-success" type="submit">Mark paid &amp; make receipt</button></div>
  </form>
</dialog>
<% } %>
<div class="paper-wrap"><%- include('../partials/bill-paper', { doc: doc }) %></div>
<script src="/static/js/builder.js?v=<%= h.v('js/builder.js') %>" defer></script>
