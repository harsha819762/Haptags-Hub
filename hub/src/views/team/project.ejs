<%
  const today = new Date().toISOString().slice(0, 10);
  const tone = { todo: 'grey', doing: 'blue', review: 'amber', done: 'green' };
  const PSTATUS = ['planning', 'in_progress', 'review', 'on_hold', 'completed', 'cancelled'];
%>
<div class="crumbs"><a href="/team/projects">Projects</a> / <%= project.name %></div>
<div class="page-head">
  <div><h1><%= project.name %> <%- h.badge(project.status) %></h1><div class="sub"><a href="/team/clients/<%= project.client_id %>"><%= project.client_name %></a> · <%= h.service(project.service) || 'Project' %><%= project.due_date ? ' · target ' + h.date(project.due_date) : '' %></div></div>
  <div class="actions">
    <form method="post" action="/team/projects/<%= project.id %>/status" class="row" style="flex-wrap:nowrap"><%- include('../partials/csrf') %>
      <select name="status" aria-label="Project status" data-autosubmit><% PSTATUS.forEach(function (s) { %><option value="<%= s %>" <%= project.status === s ? 'selected' : '' %>><%= h.humanize(s) %></option><% }) %></select>
    </form>
    <% if (canManage) { %><button class="btn btn-ghost" type="button" data-dialog="#project-edit"><%- h.icon('edit', 16) %> Edit project</button><% } %>
  </div>
</div>

<section class="card card-pad mb-16">
  <div class="row-between mb-8"><b>Overall progress</b><b data-overall-pct><%= project.progress %>%</b></div>
  <div class="progress <%= project.status === 'completed' ? 'done' : '' %>" style="height:12px"><span data-overall-bar style="width:<%= project.progress %>%"></span></div>
</section>

<%
  const COLS = [
    ['todo', 'grey', 'Not started yet'],
    ['doing', 'blue', 'Being worked on'],
    ['review', 'amber', 'Waiting for the client’s approval'],
    ['done', 'green', 'Finished'],
  ];
  const initials = function (n) { return n ? n.split(/\s+/).map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase() : '?'; };
  const assignedId = function (t) {
    if (t.assigned_to && team.some(function (m) { return m.id === t.assigned_to; })) return t.assigned_to;
    const m = t.assignee && team.find(function (x) { return x.name.toLowerCase() === String(t.assignee).toLowerCase(); });
    return m ? m.id : null;
  };
%>
<section class="mb-16 team-board-wrap" aria-labelledby="board-title">
  <div class="row-between mb-8" style="flex-wrap:wrap;gap:8px">
    <h2 id="board-title" class="mb-0">Project board</h2>
    <span class="muted small"><span data-done-count><%= tasks.filter(function (t) { return t.status === 'done'; }).length %></span>/<%= tasks.length %> done · drag a card to move it</span>
  </div>
  <form method="post" action="/team/projects/<%= project.id %>/tasks" class="card card-pad row mb-16 board-add" style="flex-wrap:wrap;gap:8px">
    <%- include('../partials/csrf') %>
    <input type="text" name="title" placeholder="Add a task with an assignee, due date and priority…" maxlength="255" aria-label="New task" style="flex:3;min-width:200px" required>
    <select name="user_id" aria-label="Assign to" style="flex:1;min-width:150px"><option value="">Assign to…</option><% team.forEach(function (m) { %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select>
    <input type="date" name="due_date" aria-label="Due date" style="max-width:160px">
    <select name="priority" aria-label="Priority" style="max-width:120px"><option value="normal">Normal</option><option value="high">High</option><option value="low">Low</option></select>
    <button class="btn" type="submit"><%- h.icon('plus', 15) %> Add task</button>
  </form>
  <div class="board team-board" id="board" data-move-url="/team/tasks/{id}/move" data-assign-url="/team/tasks/{id}/assign">
    <% COLS.forEach(function (c) { const cards = tasks.filter(function (t) { return t.status === c[0]; }); %>
    <div class="col col-<%= c[1] %>" data-col="<%= c[0] %>">
      <header><span class="dotc"></span><div><b><%= TASK_LABEL[c[0]] %></b><small><%= c[2] %></small></div><span class="n"><%= cards.length %></span></header>
      <div class="col-body">
        <% if (!cards.length) { %><div class="col-empty">Nothing here</div><% } %>
        <% cards.forEach(function (t) { const late = t.due_date && String(t.due_date).slice(0, 10) < today && t.status !== 'done'; const aid = assignedId(t); const aname = aid ? team.find(function (m) { return m.id === aid; }).name : t.assignee; %>
        <article class="bcard task" draggable="true" data-id="<%= t.id %>">
          <div class="task-top"><a class="bt" href="/team/tasks/<%= t.id %>"><%= t.title %></a><button class="x edit-task" type="button" title="Edit or delete" aria-label="Edit or delete “<%= t.title %>”" data-task-id="<%= t.id %>" data-title="<%= t.title %>" data-due="<%= t.due_date ? String(t.due_date).slice(0, 10) : '' %>" data-priority="<%= t.priority || 'normal' %>"><%- h.icon('edit', 15) %></button></div>
          <div class="task-chips"><% if (t.priority === 'high') { %><span class="chip chip-red">High priority</span><% } %><% if (t.due_date) { %><span class="chip <%= late ? 'chip-red' : '' %>"><%- h.icon('calendar', 12) %> <%= h.date(t.due_date) %></span><% } %><% if (Number(t.comments)) { %><span class="chip"><%- h.icon('chat', 12) %> <%= t.comments %></span><% } %></div>
          <div class="assign">
            <span class="avatar sm <%= aname ? '' : 'unset' %>" aria-hidden="true"><%= initials(aname) %></span>
            <select class="assign-select" aria-label="Assign “<%= t.title %>” to">
              <option value="" <%= aname ? '' : 'selected' %>>Assign to…</option>
              <% if (aname && !aid) { %><option value="keep" selected disabled><%= aname %></option><% } %>
              <% team.forEach(function (m) { %><option value="<%= m.id %>" <%= aid === m.id ? 'selected' : '' %>><%= m.name %></option><% }) %>
            </select>
            <select class="move-select" aria-label="Move “<%= t.title %>” to"><% COLS.forEach(function (o) { %><option value="<%= o[0] %>" <%= o[0] === t.status ? 'selected' : '' %>><%= TASK_LABEL[o[0]] %></option><% }) %></select>
          </div>
        </article>
        <% }) %>
      </div>
      <form method="post" action="/team/projects/<%= project.id %>/tasks" class="col-add">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="status" value="<%= c[0] %>">
        <input type="text" name="title" maxlength="255" required placeholder="+ Add a task" aria-label="Add a task to <%= TASK_LABEL[c[0]] %>">
        <button class="btn btn-sm" type="submit" aria-label="Add to <%= TASK_LABEL[c[0]] %>"><%- h.icon('plus', 14) %></button>
      </form>
    </div>
    <% }) %>
  </div>
</section>

<div class="split">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h3>Updates for the client</h3></div>
      <form method="post" action="/team/projects/<%= project.id %>/updates" class="card-body" style="border-bottom:1px solid var(--border)">
        <%- include('../partials/csrf') %>
        <div class="field"><textarea name="body" rows="3" placeholder="e.g. Homepage is live on staging — please review." aria-label="Update"></textarea></div>
        <label class="check mb-8"><input type="checkbox" name="internal" value="1"> Internal note <span class="muted">(hide from the client)</span></label>
        <button class="btn btn-sm" type="submit"><%- h.icon('send', 15) %> Post update</button>
      </form>
      <% if (!updates.length) { %><div class="empty" style="padding:22px">No updates yet.</div><% } else { %>
      <div class="card-body"><ul class="timeline"><% updates.forEach(function (u) { %><li class="k-email"><div class="meta"><%= u.user_name || 'Haptags' %> · <%= h.ago(u.created_at) %><% if (!u.client_visible) { %> <span class="chip chip-amber">Internal</span><% } %></div><div class="body"><%= u.body %></div></li><% }) %></ul></div><% } %>
    </section>
  </div>

  <div class="stack">
    <section class="card">
      <div class="card-head"><h3>Files &amp; links</h3></div>
      <% if (!files.length) { %><div class="empty" style="padding:22px">Nothing uploaded.</div><% } %>
      <ul class="list"><% files.forEach(function (f) { %><li><span class="ic blue ficon"><%- h.icon(f.url ? 'link' : 'paperclip', 15) %></span><div class="grow"><a class="title" href="<%= f.url || '/team/files/' + f.id %>" <%- f.url ? 'target="_blank" rel="noopener noreferrer"' : '' %>><%= f.label %></a><span class="meta"><%= f.url ? 'Link' : 'File' %> · <%= h.ago(f.created_at) %></span></div></li><% }) %></ul>
    </section>
    <% if (showMoney && invoices.length) { %>
    <section class="card"><div class="card-head"><h3>Invoices</h3></div><ul class="list"><% invoices.forEach(function (i) { %><li><div class="grow"><a class="title mono" href="/i/<%= i.public_token %>"><%= i.number %></a><span class="meta"><%= h.date(i.issue_date) %></span></div><b><%= h.inrShort(i.total) %></b><%- h.badge(i.status) %></li><% }) %></ul></section>
    <% } %>
  </div>
</div>

<dialog class="modal" id="task-edit" aria-labelledby="task-edit-title">
  <form method="post" action="" data-edit-form>
    <%- include('../partials/csrf') %>
    <div class="modal-head"><h2 id="task-edit-title">Edit task</h2><button class="icon-btn" type="button" data-close aria-label="Close"><%- h.icon('x') %></button></div>
    <div class="modal-body">
      <div class="field"><label for="te-title">Title *</label><input id="te-title" name="title" type="text" maxlength="255" required></div>
      <div class="form-grid">
        <div class="field"><label for="te-due">Due date</label><input id="te-due" name="due_date" type="date"></div>
        <div class="field"><label for="te-priority">Priority</label><select id="te-priority" name="priority"><option value="normal">Normal</option><option value="high">High</option><option value="low">Low</option></select></div>
      </div>
    </div>
    <div class="modal-foot" style="justify-content:space-between">
      <button class="btn btn-ghost danger-text" type="submit" formaction="" data-delete-btn data-confirm-click="Delete this task? Its comments and attachments are deleted too, and this can’t be undone."><%- h.icon('trash', 16) %> Delete task</button>
      <span class="row" style="gap:10px"><button class="btn btn-ghost" type="button" data-close>Cancel</button><button class="btn" type="submit"><%- h.icon('check', 16) %> Save</button></span>
    </div>
  </form>
</dialog>

<% if (canManage) { const day = function (v) { return v ? String(v).slice(0, 10) : ''; }; %>
<dialog class="modal" id="project-edit" aria-labelledby="project-edit-title"<%= openEdit ? ' data-open' : '' %>>
  <form method="post" action="/team/projects/<%= project.id %>/edit">
    <%- include('../partials/csrf') %>
    <div class="modal-head"><h2 id="project-edit-title">Edit project</h2><button class="icon-btn" type="button" data-close aria-label="Close"><%- h.icon('x') %></button></div>
    <div class="modal-body">
      <div class="field"><label for="pe-name">Project name *</label><input id="pe-name" name="name" type="text" maxlength="190" required value="<%= project.name %>"></div>
      <div class="form-grid">
        <div class="field"><label for="pe-client">Client *</label><select id="pe-client" name="client_id" required><% clients.forEach(function (c) { %><option value="<%= c.id %>" <%= c.id === project.client_id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
        <div class="field"><label for="pe-service">Service</label><select id="pe-service" name="service"><option value="">—</option><% SERVICES.forEach(function (sv) { %><option value="<%= sv[0] %>" <%= project.service === sv[0] ? 'selected' : '' %>><%= sv[1] %></option><% }) %></select></div>
        <div class="field"><label for="pe-start">Start date</label><input id="pe-start" name="start_date" type="date" value="<%= day(project.start_date) %>"></div>
        <div class="field"><label for="pe-due">Target date</label><input id="pe-due" name="due_date" type="date" value="<%= day(project.due_date) %>"></div>
        <div class="field full"><label for="pe-status">Status</label><select id="pe-status" name="status"><% PSTATUS.forEach(function (st) { %><option value="<%= st %>" <%= project.status === st ? 'selected' : '' %>><%= h.humanize(st) %></option><% }) %></select></div>
      </div>
      <div class="field"><label for="pe-desc">Description</label><textarea id="pe-desc" name="description" rows="3" maxlength="5000" placeholder="What this project covers"><%= project.description || '' %></textarea></div>
    </div>
    <div class="modal-foot"><button class="btn btn-ghost" type="button" data-close>Cancel</button><button class="btn" type="submit"><%- h.icon('check', 16) %> Save changes</button></div>
  </form>
  <form method="post" action="/team/projects/<%= project.id %>/delete" class="danger-zone">
    <%- include('../partials/csrf') %>
    <b>Delete this project</b>
    <p class="small muted">Deletes the project with all its tasks, comments, files, updates and milestones. This can’t be undone. Invoices are never deleted: a project with invoices can only be set to Cancelled.</p>
    <div class="row" style="gap:8px;flex-wrap:wrap">
      <input name="confirm_name" type="text" maxlength="190" required autocomplete="off" placeholder="Type “<%= project.name %>” to confirm" aria-label="Type the project name to confirm" style="flex:1;min-width:200px">
      <button class="btn btn-danger-solid" type="submit"><%- h.icon('trash', 16) %> Delete project</button>
    </div>
  </form>
</dialog>
<% } %>
