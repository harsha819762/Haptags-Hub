# Copy to .env for local use. On Hostinger, set these as Node.js environment variables instead.

NODE_ENV=production
PORT=3000
BASE_URL=https://portal.haptags.com
SESSION_SECRET=change-me-to-64-random-characters

# MySQL (Hostinger: host 127.0.0.1 from the app). Leave DB_HOST empty to use local SQLite.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# First run only: creates the owner account if none exists. Remove after signing in.
# (Use a long, unique password.)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (Hostinger mail: smtp.hostinger.com, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Haptags <info@haptags.com>
NOTIFY_EMAIL=info@haptags.com

# Razorpay (Dashboard → Account & Settings → API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional "Continue with Google" on the sign-in page (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID, type Web application). Authorised redirect URI: <BASE_URL>/auth/google/callback.
# Only people who already have an account can sign in this way; it never creates accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: cron backstop — schedule `curl -s "$BASE_URL/api/v1/cron?key=$CRON_KEY"` hourly
CRON_KEY=

# Optional: a TURN relay for video calls on networks that block direct connections.
# STUN (Cloudflare + Google) is built in. ICE_SERVERS takes a full JSON list instead, if you need it.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: where GST Invoices writes its daily backups (default: ~/haptags-hub-backups in
# production, outside the app folder that each deploy replaces; data/backups locally).
GST_BACKUP_DIR=

# Haptags LMS (certificates and the programme catalogue). Leave LMS_API_URL empty to switch the LMS links off.
LMS_API_URL=https://lms.haptags.com/hcgi/api
# LMS_PLATFORM_URL=https://lms.haptags.com/hcgi/platform

# Browser origins allowed to post enquiries directly to /api/v1/leads
LEAD_ORIGINS=https://haptags.com,https://www.haptags.com

# Leave unset in production. 1 switches the old back office (leads, partners, old invoice screens) back on.
# ENABLE_ADMIN=
